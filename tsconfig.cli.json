{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "bin",
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2020",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
