{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "bin",
    "strict": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ESNext",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["node_modules", "dist", "template"]
}
